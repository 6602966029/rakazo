---
import { BotAvatar } from "@rakazo/ui-web";

interface Props {
  color: string;
  name: string;
}

const { color, name } = Astro.props;
---

<span class="roster-bot-avatar" role="img" aria-label={name}>
  <BotAvatar color={color} identity={name} size={88} variant="organic" />
</span>

<style>
  .roster-bot-avatar {
    display: block;
    width: 88px;
    height: 88px;
    flex: 0 0 auto;
  }
</style>
