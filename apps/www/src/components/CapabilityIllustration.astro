---
import type { HomeCopy, HomeFeatureKind } from "../i18n/home";
import githubLogo from "./brand-logos/github.svg?raw";
import gmailLogo from "./brand-logos/gmail.svg?raw";
import googleCalendarLogo from "./brand-logos/googlecalendar.svg?raw";
import linearLogo from "./brand-logos/linear.svg?raw";
import notionLogo from "./brand-logos/notion.svg?raw";
import slackLogo from "./brand-logos/slack.svg?raw";

interface Props {
  kind: HomeFeatureKind;
  labels: HomeCopy["features"]["mock"];
}

const { kind, labels } = Astro.props;
const APP_LOGOS = [gmailLogo, githubLogo, notionLogo, slackLogo, linearLogo, googleCalendarLogo];
const PHONE_ICON =
  '<svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>';
---

<div class:list={["capability-art", `capability-art--${kind}`]} aria-hidden="true">
  {kind === "call" ? (
    <div class="art-call">
      <img src="/brand/job-bots/inbox-manager.webp" alt="" width="40" height="40" loading="lazy" />
      <div class="art-call__who">
        <b>Inbox Manager</b>
        <span>{labels.calling}</span>
      </div>
      <span class="art-call__button art-call__button--decline"><Fragment set:html={PHONE_ICON} /></span>
      <span class="art-call__button art-call__button--accept"><Fragment set:html={PHONE_ICON} /></span>
    </div>
  ) : kind === "apps" ? (
    <div class="art-apps">
      {APP_LOGOS.map((logo) => <span class="art-apps__tile"><Fragment set:html={logo} /></span>)}
      <span class="art-apps__tile art-apps__mcp">MCP</span>
    </div>
  ) : kind === "memory" ? (
    <div class="art-window">
      <span class="art-label">{labels.memory}</span>
      {labels.memoryNotes.map((note) => (
        <div class="art-row"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>{note}</div>
      ))}
    </div>
  ) : kind === "triggers" ? (
    <div class="art-window">
      <div class="art-row"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M7 3v4m10-4v4M3 11h18" /></svg>{labels.triggers[0]}</div>
      <div class="art-row"><svg viewBox="0 0 24 24"><circle cx="6" cy="6" r="2.5" /><circle cx="6" cy="18" r="2.5" /><circle cx="18" cy="12" r="2.5" /><path d="M6 8.5v7M8.5 6H12a3.5 3.5 0 0 1 3.5 3.5" /></svg>{labels.triggers[1]}</div>
      <div class="art-row"><svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" /><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" /></svg>{labels.triggers[2]}</div>
    </div>
  ) : kind === "teach" ? (
    <div class="art-window">
      <span class="art-label art-rec"><i />{labels.recording}</span>
      <div class="art-steps"><span /><span /><span /></div>
      <div class="art-row"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>{labels.skillSaved}</div>
    </div>
  ) : (
    <div class="art-team">
      <img src="/brand/job-bots/sales-outbound.webp" alt="" width="52" height="52" loading="lazy" />
      <span class="art-team__line"><i /></span>
      <img src="/brand/job-bots/talent-scout.webp" alt="" width="52" height="52" loading="lazy" />
    </div>
  )}
</div>

<style>
  .capability-art {
    height: 168px;
    margin: -26px -26px 24px;
    border-bottom: 1px solid var(--line);
    background: var(--surface-soft);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    overflow: hidden;
    user-select: none;
    pointer-events: none;
    font-size: 12px;
    line-height: 1.4;
  }

  svg { flex: none; width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

  .art-window {
    width: 100%;
    max-width: 240px;
    padding: 14px;
    border: 1px solid var(--line-2);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: var(--shadow-soft);
  }
  .art-label { display: block; margin-bottom: 8px; color: var(--muted-2); font-size: 11px; }
  .art-row { display: flex; align-items: center; gap: 9px; padding: 6px 0; }
  .art-row + .art-row { border-top: 1px solid var(--line); }
  .art-row svg { color: var(--muted-2); }
  .art-rec { display: flex; align-items: center; gap: 7px; margin: 0; }
  .art-rec i { width: 7px; height: 7px; border-radius: 50%; background: var(--ink); }
  .art-steps { display: flex; gap: 6px; margin: 10px 0 4px; }
  .art-steps span { flex: 1; height: 26px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface-soft); }

  .art-call {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: 280px;
    padding: 10px 10px 10px 12px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--shadow-soft);
  }
  .art-call img { width: 40px; height: 40px; border-radius: 50%; }
  .art-call__who { display: grid; flex: 1; gap: 1px; min-width: 0; }
  .art-call__who b { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .art-call__who span { color: var(--muted-2); }
  .art-call__button {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
  }
  .art-call__button :global(svg) { width: 15px; height: 15px; fill: currentColor; }
  .art-call__button--decline { border: 1px solid var(--line-2); color: var(--muted-2); }
  .art-call__button--decline :global(svg) { transform: rotate(135deg); }
  .art-call__button--accept { background: var(--ink); color: var(--surface); }

  .art-apps { display: grid; grid-template-columns: repeat(4, 44px); gap: 10px; }
  .art-apps__tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-2);
    border-radius: 11px;
    background: var(--surface);
    box-shadow: var(--shadow-soft);
  }
  .art-apps__tile :global(svg) { width: 20px; height: 20px; }
  .art-apps__tile :global(path) { fill: currentColor; }
  .art-apps__mcp { font-size: 11px; font-weight: 600; letter-spacing: 0.02em; }

  .art-team { display: flex; align-items: center; }
  .art-team img { width: 52px; height: 52px; border-radius: 50%; background: var(--surface); box-shadow: var(--shadow-soft); }
  .art-team__line { position: relative; width: 72px; height: 1px; margin: 0 8px; background: var(--line-2); }
  .art-team__line i {
    position: absolute;
    top: -3px;
    left: 50%;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border-radius: 50%;
    background: var(--ink);
  }
</style>
